# ProofLoop Environment Variables

# Baseten API Key (for Muse Spark Open)
BASETEN_API_KEY=

# Meta Model API Key (from dev.meta.ai)
META_API_KEY=

# Provider configuration per step: 'meta' or 'baseten'
# Default: tests via Meta Model API, code and repair via Baseten Muse Spark Open
TESTER_PROVIDER=meta
CODER_PROVIDER=baseten
REPAIR_PROVIDER=baseten

# Optional model overrides:
# META_MODEL=muse-spark-1.3
# BASETEN_MODEL=meta-models/muse-spark-open-1026
